# CoNote local development environment.
# Copy to `.env` (never commit `.env`). Values below are LOCAL DEVELOPMENT DEFAULTS
# matching infra/docker-compose.yml; they are not secrets and must not be used in production.
# Only variables used by the current phase are listed. Later phases add theirs
# (object storage, ...) together with the code that uses them.

# --- Shared by all services ---
NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL (api, collab, prisma) ---
# Host port 5433 maps to PostgreSQL container port 5432 in infra/docker-compose.yml.
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB below.
DATABASE_URL=postgresql://conote:conote_dev_password@localhost:5433/conote

# --- Redis (api, collab) ---
REDIS_URL=redis://localhost:6379

# --- API (apps/api) ---
PORT=4000
# Browser-facing origin of the web app (no path, no trailing slash).
APP_URL=http://localhost:3000
# Optional comma-separated CORS/origin allow-list. Defaults to APP_URL.
# ALLOWED_ORIGINS=http://localhost:3000
# Reverse proxies whose X-Forwarded-For the API trusts (comma-separated IPs, CIDRs, or the
# keywords loopback / linklocal / uniquelocal). Empty trusts none, so every client then shares
# the web server's address for rate limiting. Locally the web app reaches the API over loopback.
# In production list the web tier's address AND put a reverse proxy in front of the web app that
# sets X-Forwarded-For (Next.js does not): see docs/ARCHITECTURE.md section 10.4.
TRUST_PROXY=loopback
# Session lifetimes in days (defaults shown): idle (sliding) and absolute maximum.
# SESSION_IDLE_TTL_DAYS=7
# SESSION_ABSOLUTE_TTL_DAYS=30
# Directory for uploaded images (local-disk storage adapter, docs/DECISIONS.md D55).
# Relative paths are resolved against the API's working directory. Use a persistent volume.
# ASSET_STORAGE_DIR=.data/assets

# --- Collab server (apps/collab) ---
COLLAB_PORT=4100

# --- Web (apps/web) ---
# Server-side URL the web app uses to reach the API. It also defines the /api/* rewrite,
# which Next.js resolves at BUILD time: set it for `next build` as well, not only at runtime.
API_INTERNAL_URL=http://localhost:4000

# --- Docker Compose (infra/docker-compose.yml) ---
POSTGRES_USER=conote
POSTGRES_PASSWORD=conote_dev_password
POSTGRES_DB=conote

# ── Collaboration (Phase 6) ────────────────────────────────────────────────────────────────
# Ed25519 key pair for the short-lived collaboration tokens (D22). Generate with
# `node scripts/generate-collab-keys.mjs --write` (`pnpm bootstrap` does it for you). The API gets the private key, the
# collaboration server the public one; the two values below are placeholders, not keys.
COLLAB_JWT_PRIVATE_KEY=
COLLAB_JWT_PUBLIC_KEYS=
# Browser-facing WebSocket URL of the collaboration server.
COLLAB_URL=ws://localhost:4100
# Allowed WebSocket origins (comma-separated); defaults to APP_URL.
# COLLAB_ALLOWED_ORIGINS=
COLLAB_REVALIDATE_INTERVAL_MS=60000
COLLAB_STORE_DEBOUNCE_MS=2000
COLLAB_STORE_MAX_DEBOUNCE_MS=10000
COLLAB_COMPACT_UPDATE_COUNT=200
COLLAB_MAX_PAYLOAD_BYTES=1048576
COLLAB_MAX_AWARENESS_PER_SECOND=30
