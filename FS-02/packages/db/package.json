{
  "name": "@conote/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prisma schema, migrations and database access for CoNote.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "migrate:deploy": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
    "migrate:dev": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate dev",
    "migrate:status": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate status",
    "clean": "rm -rf dist src/generated *.tsbuildinfo"
  },
  "dependencies": {
    "@conote/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "prisma": "7.10.1"
  }
}
