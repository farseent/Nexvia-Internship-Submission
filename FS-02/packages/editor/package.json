{
  "name": "@conote/editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tiptap extension registry, slash commands and editor configuration (the Yjs binding is exported separately as @conote/editor/collaboration).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./collaboration": {
      "types": "./dist/collaboration.d.ts",
      "default": "./dist/collaboration.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@conote/shared": "workspace:*",
    "@floating-ui/dom": "1.8.0",
    "@tiptap/core": "3.33.1",
    "@tiptap/extension-collaboration": "3.33.1",
    "@tiptap/extension-image": "3.33.1",
    "@tiptap/extension-list": "3.33.1",
    "@tiptap/extension-table": "3.33.1",
    "@tiptap/extension-text-align": "3.33.1",
    "@tiptap/extensions": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@tiptap/starter-kit": "3.33.1",
    "@tiptap/suggestion": "3.33.1",
    "@tiptap/y-tiptap": "3.0.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  }
}
