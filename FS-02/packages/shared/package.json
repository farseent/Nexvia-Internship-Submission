{
  "name": "@conote/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure shared types, Zod schemas and utilities. No I/O, no repository dependencies.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "yjs": "13.6.33",
    "zod": "4.6.7"
  }
}
